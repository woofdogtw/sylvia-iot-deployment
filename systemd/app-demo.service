[Unit]
Description=Sylvia-IoT App Demo Service
Requires=sylvia-iot-infra.service
After=sylvia-iot-core.service sylvia-router.service

[Install]
WantedBy=multi-user.target

[Service]
ExecStart=/usr/local/bin/app-demo -f /etc/sylvia-iot/config-app-demo.json5
WorkingDirectory=/var/lib/sylvia-iot
Restart=always
RestartSec=5
