{
    "log": {},
    "server": {},
    "auth": {
        "db": {
            "engine": "sqlite",
            "mongodb": {
                "url": "mongodb://localhost:27017",
                "database": "sylvia-iot-auth"
            },
            "sqlite": {
                "path": "test.db"
            }
        }
    },
    "broker": {
        "auth": "http://localhost:1080/auth",
        "db": {
            "engine": "sqlite",
            "mongodb": {
                "url": "mongodb://localhost:27017",
                "database": "sylvia-iot-broker"
            },
            "sqlite": {
                "path": "test.db"
            }
        },
        "cache": {
            "engine": "memory",
            "redis": {
                "url": "redis://localhost:6379"
            }
        }
    },
    "coremgr": {
        "auth": "http://localhost:1080/auth",
        "broker": "http://localhost:1080/broker",
        "mq": {
            "engine": {
                "amqp": "rabbitmq",
                "mqtt": "emqx"
            },
            "rabbitmq": {
                "username": "guest",
                "password": "guest"
            },
            "emqx": {
                "apiKey": "",
                "apiSecret": ""
            }
        }
    },
    "coremgrCli": {
        "auth": "http://localhost:1080/auth",
        "coremgr": "http://localhost:1080/coremgr",
        "data": "http://localhost:1080/data",
        "clientId": "public",
        "redirectUri": "http://localhost:1080/auth/oauth2/redirect"
    },
    "data": {
        "auth": "http://localhost:1080/auth",
        "broker": "http://localhost:1080/broker",
        "db": {
            "engine": "sqlite",
            "mongodb": {
                "url": "mongodb://localhost:27017",
                "database": "sylvia-iot-data"
            },
            "sqlite": {
                "path": "test.db"
            }
        }
    },
    "router": {
        "auth": "http://localhost:1080/auth",
        "router": "http://localhost:1080/router",
        "wan": [
            { "name": "wan0", "ifname": "eth0" }
        ],
        "lan": { "name": "lan0", "ifname": "eth1" }
    }
}
